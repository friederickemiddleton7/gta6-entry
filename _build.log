+  }
+  addBox(scene, THREE, w - 1.2, 0.12, 0.5, x, 0.18 + 0.62, z + Math.cos(yaw) * 0.4, plainMaterial(THREE, 0x7a5a36, 0.85), yaw);
+  const board = new THREE.Mesh(
