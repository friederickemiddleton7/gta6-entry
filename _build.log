+  gradient.addColorStop(0.82, '#f2a968');
+  gradient.addColorStop(0.88, '#ffc286');
+  gradient.addColorStop(1, '#7d5a45');
+  context.fillStyle = gradient;
+  context.fillRect(0, 0, 8, 512);
+  const texture = new THREE.CanvasTexture(canvas);
+  texture.colorSpace = THREE.SRGBColorSpace;
+  texture.needsUpdate = true;
+  const material = new THREE.MeshBasicMaterial({ map: texture, side: THREE.BackSide, fog: false, depthWrite: false });
+  const dome = new THREE.Mesh(new THREE.SphereGeometry(1600, 24, 16), material);
+  dome.position.set(0, -120, 0);
+  dome.renderOrder = -10;
+  dome.frustumCulled = false;
+  return dome;
+}
