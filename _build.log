    musicTimer = t;
    scheduleBar(musicTimer);
    musicTimer += BAR;
  }

  function musicStop() {
    if (!context) return;
    musicPlaying = false;
    if (musicGain) {
      const t = now();
      musicGain.gain.cancelScheduledValues(t);
      musicGain.gain.setTargetAtTime(0.0001, t, 0.25);
    }
  }

  if (typeof window !== 'undefined') {
    setInterval(pumpMusic, 120);
  }

  return api;
}
