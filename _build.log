import re,json
for s in ['play','start','end']:
    txt=open('/tmp/p-%s.log'%s, errors='ignore').read()
    m=re.search(r'PROBE(\{.*?\})\n', txt)
    if not m:
        m=re.search(r'PROBE(\{.*\})', txt)
    try:
        d=json.loads(m.group(1))
        print(s, 'calls',d.get('calls'),'tris',d.get('tris'),'lights',d.get('lights'))
    except Exception as e:
        print(s,'parse fail',e, m.group(1)[-120:] if m else None)
