    if (player) {
      if (typeof player.ammo !== 'number' && typeof player.weapon !== 'string') {
        // Nothing to mirror yet: combat calls setWeapon once it starts.
      }
    }
  }

  renderBars();
  renderMoney();
  renderWanted();
  drawMap();
  return api;
}
