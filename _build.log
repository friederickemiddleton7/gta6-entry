+    const first = SIGN_LOOKS[(index * 2) % SIGN_LOOKS.length];
+    const second = SIGN_LOOKS[(index * 2 + 1) % SIGN_LOOKS.length];
+    addShopSign(scene, THREE, building, side, -usable * 0.22, 4.5, first[0], first[1]);
+    addShopSign(scene, THREE, building, side, usable * 0.26, 7.1, second[0], second[1]);
+  }
+}
