      return ammo;
    },
    set ammo(value) {
      ammo = clamp(Math.round(Number(value) || 0), 0, MAX_AMMO);
      syncAmmo();
    },
    get dead() {
      return dead;
    },
    get health() {
      return readHealth();
    },
    get armour() {
