    beamMaterial.color.setHex(colour);
    ringMaterial.color.setHex(colour);
    discMaterial.color.setHex(colour);
    iconMaterial.color.setHex(colour);
    iconMaterial.emissive.setHex(colour);
  }

  function placeMarker(x, z, mode) {
