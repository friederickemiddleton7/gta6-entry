+/** Dress the street inside the frame: props, shopfronts, neon and a touch of real light. */
+function dressStreet(scene, world, cameraPoint, random) {
+  const THREE = getThree();
+  const yaw = 0;
+
+  // Sidewalk furniture along both kerbs, close enough to read in the still.
+  addBench(scene, THREE, 9.7, 54, yaw + Math.PI / 2);
+  addBench(scene, THREE, 9.7, 71.5, yaw + Math.PI / 2);
+  addBench(scene, THREE, -9.8, 60, yaw - Math.PI / 2);
+  addBench(scene, THREE, -9.8, 75, yaw - Math.PI / 2);
+  addBin(scene, THREE, 9.4, 47.5);
+  addBin(scene, THREE, 9.4, 66.5);
+  addBin(scene, THREE, -9.4, 56.5);
+  addBin(scene, THREE, -9.4, 78.5);
+  addHydrant(scene, THREE, 9.2, 61.5);
+  addHydrant(scene, THREE, -9.2, 70.5);
+  addKiosk(scene, THREE, 12.4, 57.5, yaw + Math.PI, 0xc9392c);
+  addKiosk(scene, THREE, -12.2, 67.5, yaw, 0x2a9d8f);
+  addBusShelter(scene, THREE, 12.6, 74.5, yaw);
+
+  addTree(scene, THREE, 11.4, 51.5, 1.05);
